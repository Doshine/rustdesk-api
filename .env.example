# 仅为变量名模板，不得填写真实密钥后提交。
RUSTDESK_API_APP_ALLOW_INSECURE_DEVELOPMENT=false

RUSTDESK_API_GORM_TYPE=postgresql
RUSTDESK_API_GORM_AUTO_MIGRATE=false
RUSTDESK_API_POSTGRESQL_HOST=aws-1-us-west-2.pooler.supabase.com
RUSTDESK_API_POSTGRESQL_PORT=5432
RUSTDESK_API_POSTGRESQL_USER=yinhe_app_jit_runtime.rbentijitamejvkytkjk
RUSTDESK_API_POSTGRESQL_PASSWORD_FILE=/run/secrets/postgresql-password
RUSTDESK_API_POSTGRESQL_DBNAME=postgres
RUSTDESK_API_POSTGRESQL_SSLMODE=verify-full
RUSTDESK_API_POSTGRESQL_SSL_ROOT_CERT=/run/secrets/supabase-ca.pem
RUSTDESK_API_POSTGRESQL_SCHEMA=yinhe_app
RUSTDESK_API_POSTGRESQL_POOL_MODE=session

RUSTDESK_API_CACHE_TYPE=redis
RUSTDESK_API_CACHE_REDIS_ADDR=redis.example.internal:6380
RUSTDESK_API_CACHE_REDIS_USERNAME=yinhe-api
RUSTDESK_API_CACHE_REDIS_PWD_FILE=/run/secrets/redis-password
RUSTDESK_API_CACHE_REDIS_DB=0
RUSTDESK_API_CACHE_REDIS_TLS=true
RUSTDESK_API_CACHE_REDIS_TLS_CA_FILE=/run/secrets/redis-ca.pem
RUSTDESK_API_CACHE_REDIS_TLS_SERVER_NAME=redis.example.internal
RUSTDESK_API_CACHE_REDIS_KEY_PREFIX=yinhe:prod:

RUSTDESK_API_JWT_KEY_FILE=/run/secrets/jwt-key
RUSTDESK_API_MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa-encryption-key

RUSTDESK_API_SMS_PROVIDER=aliyun
RUSTDESK_API_SMS_ACCESS_KEY_ID_FILE=/run/secrets/aliyun-sms-access-key-id
RUSTDESK_API_SMS_ACCESS_KEY_SECRET_FILE=/run/secrets/aliyun-sms-access-key-secret
RUSTDESK_API_SMS_SIGN_NAME=
RUSTDESK_API_SMS_TEMPLATE_CODE=

RUSTDESK_API_PASSKEY_ENABLED=true
RUSTDESK_API_PASSKEY_RP_ID=api-yinhe.ljedu.net
RUSTDESK_API_PASSKEY_ORIGINS=https://api-yinhe.ljedu.net

RUSTDESK_API_RUSTDESK_KEY=
